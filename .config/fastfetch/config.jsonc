{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#CDD6F4"
    },
    "key": {
      "width": 14
    }
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/jirachi.txt",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#F5C2E7",
        "at": "#6C7086",
        "host": "#CBA6F7"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[90m ───────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": " 󰣇 OS",
      "keyColor": "#89B4FA",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": " 󰌽 Kernel",
      "keyColor": "#CBA6F7"
    },
    {
      "type": "packages",
      "key": " 󰏖 Packages",
      "keyColor": "#FAB387"
    },
    {
      "type": "shell",
      "key": "  Shell",
      "keyColor": "#A6E3A1",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "  WM",
      "keyColor": "#F9E2AF",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "  CPU",
      "keyColor": "#94E2D5"
    },
    {
      "type": "gpu",
      "key": " 󰢮 GPU",
      "keyColor": "#F5C2E7"
    },
    {
      "type": "display",
      "key": " 󰍹 Screen",
      "keyColor": "#89DCEB",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "memory",
      "key": "  Ram",
      "keyColor": "#F38BA8",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": " 󰋊 Disk",
      "keyColor": "#A6E3A1",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "uptime",
      "key": " 󰔚 Uptime",
      "keyColor": "#F9E2AF"
    },
    "break",
    {
      "type": "custom",
      "key": " 󰸱 Color",
      "format": "\u001b[38;2;249;226;175m󰮯 \u001b[38;2;137;220;235m \u001b[38;2;243;139;168m󰊠 \u001b[38;2;166;227;161m󰊠 \u001b[38;2;137;180;250m󰊠 \u001b[38;2;203;166;247m󰊠 \u001b[38;2;205;214;244m󰊠 \u001b[0m"
    }
  ]
}
